#!/bin/bash -e

# Enable jemalloc for reduced memory usage and latency.
if [ -z "${LD_PRELOAD+x}" ]; then
    LD_PRELOAD=$(find /usr/lib -name libjemalloc.so.2 -print -quit)
    export LD_PRELOAD
fi

# Build DATABASE_URL from individual ECS env vars when not set directly
if [ -z "${DATABASE_URL:-}" ] && [ -n "${DB_PASSWORD:-}" ]; then
  export DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:5432/${DB_NAME}"
fi

# If running the rails server then create or migrate existing database
if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
  ./bin/rails db:prepare
  # Seed demo data on first boot (when DB is empty)
  USER_COUNT=$(./bin/rails runner 'print User.count' 2>/dev/null || echo "0")
  if [ "$USER_COUNT" = "0" ]; then
    echo "Empty database detected — running db:seed"
    ./bin/rails db:seed
  fi
fi

exec "${@}"
